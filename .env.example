# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.
POSTGRES_URL=postgresql://***
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
BASE_URL=http://localhost:3000
AUTH_SECRET=***

# AI Studio — Alibaba Cloud Bailian (DashScope) text-to-image
# Get a key at https://bailian.console.aliyun.com/ (API-KEY management)
DASHSCOPE_API_KEY=sk-***
# Optional: use https://dashscope-intl.aliyuncs.com for the international endpoint
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# Optional: credits granted to each new team on sign-up (default 100)
SIGNUP_BONUS_CREDITS=100

# AI Studio image storage — Alibaba Cloud OSS (optional; all unset = local public/generated fallback)
# All four required to enable OSS mode; the bucket should be public-read.
# Tip: use a RAM sub-account scoped to oss:PutObject/oss:DeleteObject on {bucket}/ai-studio/generated/*
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=LTAI***
OSS_ACCESS_KEY_SECRET=***
# Optional: custom/CDN base URL for stored images (default: https://{bucket}.{region}.aliyuncs.com)
# OSS_PUBLIC_BASE_URL=https://cdn.example.com

# Platform administrators (comma-separated emails) can manage AI models at /admin/models
ADMIN_EMAILS=you@example.com